alias lt='ls --tree -L=3 --group-directories-first --git-ignore'
alias fastfetch="/usr/bin/fastfetch -c ~/.config/fastfetch/config.jsonc"
alias hnix='$EDITOR ~/.config/home-manager/home.nix'
