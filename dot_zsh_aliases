#!/bin/zsh

alias cz='chezmoi'
alias cdf='cd $(fd -t d | fzf)'
alias cdd='cd /var/mnt/data/Projects && cdf'
alias cls='clear'
alias reload-zsh='source ~/.zshrc'
alias ls='eza --icons --group-directories-first --sort=name'
